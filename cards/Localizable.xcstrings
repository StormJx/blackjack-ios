          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may buy half-bet insurance; if the dealer has blackjack, insurance pays 2:1. Not available after all-in."
          }
        }
      }
    },
    "insurance.rulesDetail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可买半注保险；庄家黑杰克时保险按 2:1 赔付，主注仍按胜负结算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
