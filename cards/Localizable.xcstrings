    "help.body.challenge1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有筹码与庄家资金池。打穿庄家或累计赢码可解锁更高关卡，新会话双方起始筹码随关提升。注码三档单选；开局全下需本会话打满设置中的解锁局数（可配置，默认 5；设为 0 则开局可用）。玩法道具在闯关中不可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You and the dealer have chip banks. Clear the dealer or win chips to unlock higher stages; both start with more chips in a new session. Pick one of three bet sizes. Opening all-in unlocks after the session hand count in Settings (default 5; 0 = available immediately). Gameplay props are off in Challenge."
          }
        }
      }
    },
    "help.body.challenge2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前关卡、起始筹码与距下一关差额见「战绩」；成就与道具兑换见「成就」。卡背解锁也主要看闯关表现。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See Stats for your stage, starting chips, and the gap to the next stage. Achievements and prop unlocks are on Achievements. Card backs also unlock mainly from Challenge play."
          }
        }
      }
    },
    "help.body.entertainment1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立娱乐阶梯：打穿或累计赢码升阶，本阶起始筹码与注码随之提升。已解锁的玩法道具仅在此模式可用（见牌后再全下、软 17 要牌、窥视、换一张、换庄家一张等）。支持「同上局」下注；切牌固定为真实渗透（不受设置页切牌选项影响）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate Entertainment stages: clear the dealer or win chips to advance; starting chips and bets rise with the stage. Unlocked gameplay props work only here (mid-hand all-in, dealer hits soft 17, peek, redraw one, replace a dealer card, and more). Repeat last bet is available. Cut card is always real penetration (Settings cut option does not apply)."
          }
        }
      }
    },
    "help.body.entertainment2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "娱乐对局计入娱乐成就轨，不计入闯关成就。当前阶、注码与距下一阶差额见「战绩」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entertainment hands count toward Entertainment achievements only, not Challenge. See Stats for your stage, bets, and the gap to the next stage."
          }
        }
      }
    },
    "help.body.meta1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认牌副、闯关切牌三态（每局重洗 / 仪式感 / 真实）、闯关桌限、全下解锁局数、卡背、音效与触觉：均在「设置」中调整。牌副、切牌、桌限与全下解锁局数对局中修改不生效，须返回主页再开新局；音效、触觉、局内全下确认与卡背可立即生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default shoe, Challenge cut (every-hand shuffle / ceremonial / real), Challenge table limits, all-in unlock hands, card back, sound, and haptics are in Settings. Deck, cut, table limits, and all-in unlock hands apply only on a new round from the home screen. Sound, haptics, mid-hand all-in confirm, and card back apply immediately."
          }
        }
      }
    },
    "help.body.meta2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「战绩」展示关卡/阶梯进度与胜负摘要；「成就」展示成就与道具兑换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats shows stage progress and win/loss summaries. Achievements shows achievements and prop unlocks."
          }
        }
      }
    },
    "help.body.note": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用面向练习与娱乐，规则为简化版赌场二十一点，不等同于线下赌场全部选项（如分牌尚未开放）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is for practice and play. Rules are simplified casino blackjack and do not include every live option (split is not available yet)."
          }
        }
      }
    },
    "help.body.rules": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比点数接近 21 且不爆牌。庄家点数小于 17 必须要牌，大于等于 17 停牌（软 17 同停）。玩家回合开局两张时可「加倍」（再押等额、只补一张）或「投降」（退回半注；本局全下时不可投降）。庄家明牌为 A 时可买半注「保险」（2:1；全下不可买）；随后庄家查看是否黑杰克，有则直接结算。天然黑杰克赔率 3:2，普通获胜 1:1，平局退注。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get closer to 21 than the dealer without busting. The dealer hits below 17 and stands on 17 or more (soft 17 stands). On your first two cards you may Double (match the bet, one card only) or Surrender (half bet back; not after all-in). If the dealer upcard is an Ace, you may buy half-bet Insurance (2:1; not after all-in); the dealer then checks for blackjack and settles if they have it. Natural blackjack pays 3:2, a regular win pays 1:1, and a push returns the bet."
          }
        }
      }
    },
