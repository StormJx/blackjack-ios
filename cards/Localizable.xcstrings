    "privacy.body.collect": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不创建账号，不收集个人身份信息，不使用追踪技术，也不向第三方发送对局数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app has no accounts, does not collect personal identity data, does not track you, and does not send hand data to third parties."
          }
        }
      }
    },
    "privacy.body.storage": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "战绩、成就、关卡进度、设置与外观仅使用本机存储（系统用户默认设置）。卸载应用将删除这些数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats, achievements, stage progress, settings, and cosmetics are stored only on this device (system user defaults). Deleting the app removes this data."
          }
        }
      }
    },
    "privacy.body.ads": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本不含广告软件开发包，也不会在对局进行中弹出广告。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version includes no ad SDK and will not show ads during a hand."
          }
        }
      }
    },
    "privacy.body.age": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用为模拟筹码的二十一点练习，不含真实货币赌博。上架时将按模拟赌博相关分级申报。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a practice blackjack game with simulated chips, not real-money gambling. Store age rating will follow simulated-gambling guidelines."
          }
        }
      }
    },
    "privacy.body.positioning": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "产品以公平闯关为主；娱乐模式的道具只影响该模式，不改变闯关赔率与牌值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The product is fair-challenge first. Entertainment props affect that mode only and never change Challenge odds or card values."
          }
        }
      }
    }
  },
  "version": "1.0"
}
