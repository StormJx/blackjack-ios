    "prop.redrawOne.detail": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅娱乐模式：弃掉最近一次要牌得到的牌并重发一张（须已要过牌）。每局限 1 次；天然 BJ 不可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entertainment only: discard the last hit card and draw a replacement (you must have already hit). Once per hand; unavailable on a natural BJ."
          }
        }
      }
    },
