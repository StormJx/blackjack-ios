    "help.section.positioning": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "产品定位"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About this app"
          }
        }
      }
    },
    "help.body.positioning": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本品以公平闯关为主：闯关只用规则内筹码，玩法道具仅娱乐模式可用。不卖筹码，也不在对局中插广告。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a fair challenge-first practice app. Challenge mode uses standard chips only; gameplay props stay in Entertainment. No chip sales, and no ads during a hand."
          }
        }
      }
    },
    "help.body.privacy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不采集账号或追踪数据；进度仅保存在本机。详见设置中的「隐私说明」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No accounts or tracking. Progress stays on this device. See Privacy in Settings."
          }
        }
      }
    },
    "privacy.navTitle": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
